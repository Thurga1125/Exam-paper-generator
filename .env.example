# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Free alternative: Google Gemini (aistudio.google.com/apikey) via its OpenAI-compatible API.
# Put the Gemini key in OPENAI_API_KEY and uncomment these three lines:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001

# PDF export (LibreOffice binary). Leave unset to auto-detect `soffice`.
# SOFFICE_PATH=/opt/homebrew/bin/soffice
